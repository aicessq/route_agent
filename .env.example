# 结构性配置放在 config/app.yaml；密钥和本机地址只放环境变量。
APP_ENV=local
APP_NAME=sixfoot-route-agent
APP_LOG_LEVEL=INFO

# 本地依赖
MYSQL_DSN=mysql+asyncmy://route_agent:route_agent@127.0.0.1:3307/route_agent
REDIS_URL=redis://127.0.0.1:6380/0
ELASTICSEARCH_URL=http://127.0.0.1:9201
ELASTICSEARCH_INDEX=route_agent_routes

# 模型配置（初始化阶段不要求配置）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
