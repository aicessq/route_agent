        "participants": {"children": true, "child_ages": [8]},
        "max_distance_km": 8,
        "max_elevation_gain_m": 300,
        "avoid_risk_types": ["risk_cliff_exposure"],
        "max_duration_minutes": 120,
        "required_facilities": ["water_source", "store"]
      },
      "expected": {
        "status": "VERIFIED_MATCHES",
        "verified_route_ids": ["bj-yanqing-001"],
        "route_expectations": [
          {"route_id": "bj-yanqing-001", "hard_pass": true}
        ]
      }
    },
    {
      "query_id": "huairou_basic",
      "description": "怀柔基础约束：未要求规避悬崖，距离爬升满足即通过",
