      "description": "静态距离证据短宽限期内可用：PASS 且标记陈旧",
      "intent": {
        "location": "北京·延庆",
        "max_distance_km": 8,
        "max_elevation_gain_m": 300
      },
      "evidence_overrides": [
        {"route_id": "bj-yanqing-001", "fact_type": "distance_km", "valid_until_offset_seconds": -21660}
      ],
      "expected": {
        "status": "VERIFIED_MATCHES",
        "verified_route_ids": ["bj-yanqing-001"],
        "route_expectations": [
          {"route_id": "bj-yanqing-001", "hard_pass": true, "check": {"constraint": "max_distance_km", "status": "PASS", "stale": true}}
        ]
