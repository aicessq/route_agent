        "verified_route_ids": ["bj-yanqing-001", "bj-mentougou-003"],
        "route_expectations": [
          {"route_id": "bj-yanqing-001", "hard_pass": true},
          {"route_id": "bj-mentougou-003", "hard_pass": true},
          {"route_id": "bj-huairou-002", "hard_pass": false, "check": {"constraint": "avoid_risk_types", "status": "FAIL"}},
          {"route_id": "bj-miyun-004", "hard_pass": false, "check": {"constraint": "avoid_risk_types", "status": "UNKNOWN"}}
        ]
      }
    },
    {
