{
  "spec_version": "golden-queries.v1",
  "fixture_note": "基于 FakeRouteProvider 默认 fixture：bj-yanqing-001(7.6km/248m/无风险)、bj-huairou-002(6.2km/180m/悬崖)、bj-mentougou-003(8.5km/260m/无风险)、bj-miyun-004(5.5km/210m/风险证据缺失)",
  "queries": [
